# a project saved by 0.9 before the layer pages (format 3) loads with its settings; the bass's and
# the pulse's new ones come from each piece's recipe
wait 300
turn PRESET 4
expect piece 4
storev3 33
reboot
wait 300
expect piece 4
expect par0 33
expect par23 -1
expect par24 36
expect par25 28
expect par26 8
expect par27 22
tap SAVE
reboot
wait 300
expect par0 33
expect par26 8
